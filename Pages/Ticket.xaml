            <Button Content="Вернуться" Click="Back" VerticalAlignment="Center" HorizontalAlignment="Right" Height="25" Width="100" Margin="0,0,25,0"/>
        </Grid>
        <Grid Margin="0,68,0,0" Background="White">
            <ScrollViewer>
                <StackPanel x:Name="parrent">

                </StackPanel>
            </ScrollViewer>
        </Grid>

    </Grid>
</Page>
