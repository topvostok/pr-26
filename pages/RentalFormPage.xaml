<Page x:Class="WpfApp1.Pages.RentalFormPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16,24,20">
        <StackPanel MaxWidth="720">

            <Grid Margin="0,0,0,22">
                <StackPanel>
                    <TextBlock x:Name="FormTitle" Text="НОВАЯ АРЕНДА"
                               FontFamily="Segoe UI Black" FontSize="22"
                               Foreground="#FFF0F4FF" FontWeight="Black"/>
                    <TextBlock Text="Выберите клиента и снаряжение"
                               FontFamily="Segoe UI" FontSize="11"
                               Foreground="#44FF5C3A" Margin="2,3,0,0"/>
                </StackPanel>
                <Button Content="← Назад" Style="{StaticResource BtnGhost}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="BtnBack_Click"/>
            </Grid>

            <Border Background="#080D1A" CornerRadius="12"
                    BorderBrush="#1AFF5C3A" BorderThickness="1" Padding="28">
                <StackPanel>

                    <!-- Client + Equipment -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="КЛИЕНТ *" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CbClient" Style="{StaticResource RentalCombo}"
                                      DisplayMemberPath="FullName"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="СНАРЯЖЕНИЕ *" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CbEquip" Style="{StaticResource RentalCombo}"
                                      DisplayMemberPath="Name"
                                      SelectionChanged="CbEquip_Changed"/>
                        </StackPanel>
                    </Grid>

                    <!-- Dates -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="ДАТА НАЧАЛА *" Style="{StaticResource FieldLabel}"/>
                            <DatePicker x:Name="DpStart" Style="{StaticResource RentalDatePicker}"
                                        SelectedDateChanged="DpDate_Changed"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="ДАТА ВОЗВРАТА *" Style="{StaticResource FieldLabel}"/>
                            <DatePicker x:Name="DpEnd" Style="{StaticResource RentalDatePicker}"
                                        SelectedDateChanged="DpDate_Changed"/>
                        </StackPanel>
                    </Grid>

                    <!-- Days + Total + Deposit (auto-calculated) -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/><ColumnDefinition Width="20"/>
                            <ColumnDefinition/><ColumnDefinition Width="20"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="ДНЕЙ" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TbDays" Style="{StaticResource RentalTextBox}"
                                     IsReadOnly="True" Background="#05FFFFFF"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="ИТОГО ₽" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TbTotal" Style="{StaticResource RentalTextBox}"
                                     IsReadOnly="True" Background="#05FFFFFF"
                                     Foreground="#FFC87DFF" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="ЗАЛОГ ₽" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TbDeposit" Style="{StaticResource RentalTextBox}" Text="0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Status -->
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="СТАТУС" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="CbStatus" Style="{StaticResource RentalCombo}" Width="200"
                                  HorizontalAlignment="Left">
                            <ComboBoxItem Content="Активна"/>
                            <ComboBoxItem Content="Просрочена"/>
                            <ComboBoxItem Content="Завершена"/>
                            <ComboBoxItem Content="Отменена"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Notes -->
                    <StackPanel Margin="0,0,0,28">
                        <TextBlock Text="ЗАМЕТКИ" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TbNotes" Style="{StaticResource RentalTextBox}"
                                 Height="70" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="💾  Сохранить" Style="{StaticResource BtnCyan}"
                                Click="BtnSave_Click" Margin="0,0,10,0"/>
                        <Button Content="Отмена" Style="{StaticResource BtnGhost}"
                                Click="BtnBack_Click" Margin="0,0,10,0"/>
                        <Button x:Name="BtnDelete" Content="🗑  Удалить"
                                Style="{StaticResource BtnRed}"
                                Visibility="Collapsed"
                                Click="BtnDelete_Click"/>
                    </StackPanel>

                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
