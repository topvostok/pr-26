<Window x:Class="WpfApp1.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ALPINE RENTAL — Панель управления"
        Width="1320" Height="800"
        MinWidth="1000" MinHeight="640"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen">

    <Border Background="#FF060810" CornerRadius="12"
            BorderBrush="#1A5DE0FF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="50" ShadowDepth="0" Color="#000000" Opacity="0.9"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="215"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ══════════════════════════════════════════
                 SIDEBAR
            ══════════════════════════════════════════ -->
            <Border Grid.Column="0"
                    Background="#FF08091A"
                    BorderBrush="#0BFFFFFF" BorderThickness="0,0,1,0"
                    CornerRadius="12,0,0,12">

                <!-- Glow top-left -->
               

                <DockPanel>
                    <!-- LOGO -->
                    <Border DockPanel.Dock="Top" Padding="20,26,20,20">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                <Viewbox Width="20" Height="20" Margin="0,0,8,0">
                                    <Canvas Width="24" Height="24">
                                        <Polygon Points="12,2 22,20 2,20" Fill="Transparent"
                                                 Stroke="#FF5DE0FF" StrokeThickness="1.5"/>
                                        <Ellipse Canvas.Left="9.5" Canvas.Top="13" Width="5" Height="5"
                                                 Fill="#FF5DE0FF"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="ALPINE" FontFamily="Segoe UI Black" FontSize="15"
                                           Foreground="#FFF0F4FF" VerticalAlignment="Center"
                                           FontWeight="Black"/>
                            </StackPanel>
                            <TextBlock Text="RENTAL SYSTEM" FontFamily="Segoe UI"
                                       FontSize="7" Foreground="#2A5DE0FF"
                                       Margin="28,0,0,0" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <!-- Separator -->
                    <Rectangle DockPanel.Dock="Top" Height="1"
                               Fill="#0BFFFFFF" Margin="14,0"/>

                    <!-- DB status -->
                    <Border DockPanel.Dock="Top" Padding="14,10" Margin="8,8,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="DbDot" Width="7" Height="7"
                                     Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse.Fill>
                                    <SolidColorBrush x:Name="DbDotBrush" Color="#33888888"/>
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock x:Name="DbStatusTxt" Text="Проверка..."
                                       FontFamily="Segoe UI" FontSize="10"
                                       Foreground="#33A0B8CC" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- NAV: Снаряжение -->
                    <StackPanel DockPanel.Dock="Top" Margin="8,14,8,0">
                        <TextBlock Text="СНАРЯЖЕНИЕ" FontFamily="Segoe UI"
                                   FontSize="7" FontWeight="SemiBold"
                                   Foreground="#1F5DE0FF" Margin="10,0,0,5"/>
                        <Button x:Name="NavEqList" Style="{StaticResource BtnNav}"
                                Tag="EqList" Click="NavBtn_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📋" FontSize="13" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Список снаряжения" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavEqAdd" Style="{StaticResource BtnNav}"
                                Tag="EqAdd" Click="NavBtn_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="➕" FontSize="13" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Добавить" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- NAV: Клиенты -->
                    <StackPanel DockPanel.Dock="Top" Margin="8,14,8,0">
                        <TextBlock Text="КЛИЕНТЫ" FontFamily="Segoe UI"
                                   FontSize="7" FontWeight="SemiBold"
                                   Foreground="#1FA3FF5C" Margin="10,0,0,5"/>
                        <Button x:Name="NavClList" Style="{StaticResource BtnNav}"
                                Tag="ClList" Click="NavBtn_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👥" FontSize="13" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Список клиентов" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavClAdd" Style="{StaticResource BtnNav}"
                                Tag="ClAdd" Click="NavBtn_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="➕" FontSize="13" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Добавить" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- NAV: Аренды -->
                    <StackPanel DockPanel.Dock="Top" Margin="8,14,8,0">
                        <TextBlock Text="АРЕНДЫ" FontFamily="Segoe UI"
                                   FontSize="7" FontWeight="SemiBold"
                                   Foreground="#1FFF5C3A" Margin="10,0,0,5"/>
                        <Button x:Name="NavRnList" Style="{StaticResource BtnNav}"
                                Tag="RnList" Click="NavBtn_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎿" FontSize="13" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Все аренды" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavRnAdd" Style="{StaticResource BtnNav}"
                                Tag="RnAdd" Click="NavBtn_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="➕" FontSize="13" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Новая аренда" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- NAV: Возвраты -->
                    <StackPanel DockPanel.Dock="Top" Margin="8,14,8,0">
                        <TextBlock Text="ВОЗВРАТЫ" FontFamily="Segoe UI"
                                   FontSize="7" FontWeight="SemiBold"
                                   Foreground="#1FC87DFF" Margin="10,0,0,5"/>
                        <Button x:Name="NavRetList" Style="{StaticResource BtnNav}"
                                Tag="RetList" Click="NavBtn_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📦" FontSize="13" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Все возвраты" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavRetAdd" Style="{StaticResource BtnNav}"
                                Tag="RetAdd" Click="NavBtn_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="➕" FontSize="13" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Оформить возврат" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Bottom -->
                    <Border DockPanel.Dock="Bottom" Padding="20,14">
                        <TextBlock Text="v1.0 · Alpine Rental" FontFamily="Segoe UI"
                                   FontSize="9" Foreground="#18A0B8CC"/>
                    </Border>
                </DockPanel>
            </Border>

            <!-- ══════════════════════════════════════════
                 MAIN CONTENT AREA
            ══════════════════════════════════════════ -->
            <Grid Grid.Column="1">
                <!-- Titlebar -->
                <Border Height="44" VerticalAlignment="Top"
                        Background="Transparent"
                        MouseLeftButtonDown="TitleBar_MouseDown">
                    <Grid Margin="20,0,8,0">
                        <TextBlock x:Name="PageTitle" Text="Снаряжение"
                                   FontFamily="Segoe UI Semibold" FontSize="13"
                                   Foreground="#FFF0F4FF" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Button Content="─" Width="30" Height="24"
                                    Style="{StaticResource BtnGhost}" Padding="0"
                                    Click="BtnMin_Click"/>
                            <Button Content="□" Width="30" Height="24"
                                    Style="{StaticResource BtnGhost}" Padding="0"
                                    Margin="3,0" Click="BtnMax_Click"/>
                            <Button Content="✕" Width="30" Height="24"
                                    Style="{StaticResource BtnRed}" Padding="0"
                                    Click="BtnClose_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Page Frame -->
                <Frame x:Name="AdminFrame"
                       Margin="0,44,0,0"
                       NavigationUIVisibility="Hidden"
                       Background="Transparent"/>
            </Grid>

        </Grid>
    </Border>
</Window>
