<Page x:Class="WpfApp1.Pages.ClientFormPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16,24,20">
        <StackPanel MaxWidth="720">

            <!-- Header -->
            <Grid Margin="0,0,0,22">
                <StackPanel>
                    <TextBlock x:Name="FormTitle" Text="НОВЫЙ КЛИЕНТ"
                               FontFamily="Segoe UI Black" FontSize="22"
                               Foreground="#FFF0F4FF" FontWeight="Black"/>
                    <TextBlock Text="Введите данные клиента"
                               FontFamily="Segoe UI" FontSize="11"
                               Foreground="#44A3FF5C" Margin="2,3,0,0"/>
                </StackPanel>
                <Button Content="← Назад" Style="{StaticResource BtnGhost}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="BtnBack_Click"/>
            </Grid>

            <Border Background="#080D1A" CornerRadius="12"
                    BorderBrush="#1AA3FF5C" BorderThickness="1" Padding="28">
                <StackPanel>

                    <!-- ФИО -->
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="ФИО *" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TbName" Style="{StaticResource RentalTextBox}"/>
                    </StackPanel>

                    <!-- Phone + Email -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="ТЕЛЕФОН *" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TbPhone" Style="{StaticResource RentalTextBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="EMAIL" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TbEmail" Style="{StaticResource RentalTextBox}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Passport + BirthDate -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="ПАСПОРТ" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TbPassport" Style="{StaticResource RentalTextBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="ДАТА РОЖДЕНИЯ" Style="{StaticResource FieldLabel}"/>
                            <DatePicker x:Name="DpBirth" Style="{StaticResource RentalDatePicker}"/>
                        </StackPanel>
                    </Grid>

                    <!-- SkillLevel + LoyaltyPts -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="УРОВЕНЬ КАТАНИЯ" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CbSkill" Style="{StaticResource RentalCombo}">
                                <ComboBoxItem Content="Новичок"/>
                                <ComboBoxItem Content="Любитель"/>
                                <ComboBoxItem Content="Продвинутый"/>
                                <ComboBoxItem Content="Профессионал"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="БОНУСНЫЕ БАЛЛЫ" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TbLoyalty" Style="{StaticResource RentalTextBox}" Text="0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Notes -->
                    <StackPanel Margin="0,0,0,28">
                        <TextBlock Text="ЗАМЕТКИ" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TbNotes" Style="{StaticResource RentalTextBox}"
                                 Height="70" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>

                    <!-- Buttons -->
                    <StackPanel Orientation="Horizontal">
                        <Button Content="💾  Сохранить" Style="{StaticResource BtnCyan}"
                                Click="BtnSave_Click" Margin="0,0,10,0"/>
                        <Button Content="Отмена" Style="{StaticResource BtnGhost}"
                                Click="BtnBack_Click" Margin="0,0,10,0"/>
                        <Button x:Name="BtnDelete" Content="🗑  Удалить"
                                Style="{StaticResource BtnRed}"
                                Visibility="Collapsed"
                                Click="BtnDelete_Click"/>
                    </StackPanel>

                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
