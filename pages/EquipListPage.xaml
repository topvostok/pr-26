<Page x:Class="WpfApp1.Pages.EquipListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:conv="clr-namespace:WpfApp1.Converters"
      Background="Transparent">
    <Page.Resources>
    </Page.Resources>

    <Grid Margin="24,16,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="СНАРЯЖЕНИЕ" FontFamily="Segoe UI Black" FontSize="24"
                           Foreground="#FFF0F4FF" FontWeight="Black"/>
                <TextBlock x:Name="SubTitle" Text="загрузка..." FontFamily="Segoe UI"
                           FontSize="11" Foreground="#445DE0FF" Margin="2,2,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="＋  Добавить" Style="{StaticResource BtnCyan}"
                        Click="BtnAdd_Click" Margin="0,0,8,0"/>
                <Button Content="↻  Обновить" Style="{StaticResource BtnGhost}"
                        Click="BtnRefresh_Click"/>
            </StackPanel>
        </Grid>

        <!-- Stats row -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource StatCard}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="ПОЗИЦИЙ" FontFamily="Segoe UI" FontSize="8"
                               FontWeight="SemiBold" Foreground="#445DE0FF" Margin="0,0,0,5"/>
                    <TextBlock x:Name="S0" Text="—" FontFamily="Segoe UI Black"
                               FontSize="26" Foreground="#FF5DE0FF"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource StatCard}"
                    Margin="0,0,8,0" BorderBrush="#1AA3FF5C">
                <StackPanel>
                    <TextBlock Text="НОВЫХ" FontFamily="Segoe UI" FontSize="8"
                               FontWeight="SemiBold" Foreground="#44A3FF5C" Margin="0,0,0,5"/>
                    <TextBlock x:Name="S1" Text="—" FontFamily="Segoe UI Black"
                               FontSize="26" Foreground="#FFA3FF5C"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource StatCard}"
                    Margin="0,0,8,0" BorderBrush="#1AFF5C3A">
                <StackPanel>
                    <TextBlock Text="ТРЕБУЕТ РЕМОНТА" FontFamily="Segoe UI" FontSize="8"
                               FontWeight="SemiBold" Foreground="#44FF5C3A" Margin="0,0,0,5"/>
                    <TextBlock x:Name="S2" Text="—" FontFamily="Segoe UI Black"
                               FontSize="26" Foreground="#FFFF5C3A"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource StatCard}" BorderBrush="#1AC87DFF">
                <StackPanel>
                    <TextBlock Text="СРЕДНЯЯ ЦЕНА/ДЕНЬ" FontFamily="Segoe UI" FontSize="8"
                               FontWeight="SemiBold" Foreground="#44C87DFF" Margin="0,0,0,5"/>
                    <TextBlock x:Name="S3" Text="—" FontFamily="Segoe UI Black"
                               FontSize="22" Foreground="#FFC87DFF"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Search + Table -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBox x:Name="SearchBox" Grid.Row="0"
                     Style="{StaticResource RentalTextBox}"
                     Width="260" HorizontalAlignment="Left"
                     Margin="0,0,0,10"
                     Tag="🔍  Поиск по названию, бренду..."
                     TextChanged="SearchBox_TextChanged"/>

            <Border Grid.Row="1" Background="#060A14" CornerRadius="10"
                    BorderBrush="#0AFFFFFF" BorderThickness="1">
                <DataGrid x:Name="Grid0" Style="{StaticResource RentalGrid}"
                          Margin="0,4,0,4"
                          MouseDoubleClick="Grid_DoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="КАТ." Binding="{Binding CategoryIcon}" Width="50"/>
                        <DataGridTextColumn Header="НАЗВАНИЕ" Binding="{Binding Name}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Medium"/>
                                    <Setter Property="Foreground" Value="#FFF0F4FF"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="БРЕНД"    Binding="{Binding Brand}"        Width="110"/>
                        <DataGridTextColumn Header="РАЗМЕР"   Binding="{Binding SizeValue}"    Width="80"/>
                        <DataGridTextColumn Header="СОСТОЯНИЕ" Binding="{Binding ConditionLvl}" Width="140"/>
                        <DataGridTextColumn Header="ЦЕНА/ДЕНЬ" Binding="{Binding PriceDisplay}" Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#FF5DE0FF"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="СКЛАД" Binding="{Binding StockDisplay}" Width="80"/>
                        <DataGridTemplateColumn Header="ДЕЙСТВИЯ" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource BtnIcon}"
                                                Tag="{Binding Id}" Click="BtnEdit_Click"
                                                ToolTip="Редактировать">
                                            <TextBlock Text="✏" FontSize="12" Foreground="#775DE0FF"/>
                                        </Button>
                                        <Button Style="{StaticResource BtnIcon}"
                                                Tag="{Binding Id}" Click="BtnDel_Click"
                                                ToolTip="Удалить" Margin="2,0,0,0">
                                            <TextBlock Text="🗑" FontSize="12" Foreground="#77FF5C3A"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</Page>
