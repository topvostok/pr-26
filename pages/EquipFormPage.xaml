<Page x:Class="WpfApp1.Pages.EquipFormPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:WpfApp1.Pages"
      Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16,24,20">
        <StackPanel MaxWidth="720">

            <!-- Header -->
            <Grid Margin="0,0,0,22">
                <StackPanel>
                    <TextBlock x:Name="FormTitle" Text="НОВОЕ СНАРЯЖЕНИЕ"
                               FontFamily="Segoe UI Black" FontSize="22"
                               Foreground="#FFF0F4FF" FontWeight="Black"/>
                    <TextBlock Text="Заполните все обязательные поля"
                               FontFamily="Segoe UI" FontSize="11"
                               Foreground="#445DE0FF" Margin="2,3,0,0"/>
                </StackPanel>
                <Button Content="← Назад" 
                        Style="{StaticResource BtnGhost}"
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Center"
                        Click="BtnBack_Click"
                        Padding="12,6"/>
            </Grid>

            <!-- Card -->
            <Border Background="#080D1A" CornerRadius="12"
                    BorderBrush="#1A5DE0FF" BorderThickness="1" Padding="28">
                
                <StackPanel>

                    <!-- Row 1: Название + Бренд -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="НАЗВАНИЕ *" 
                                       FontFamily="Segoe UI" FontSize="10" 
                                       Foreground="#88F2F2F2" Margin="0,0,0,4"/>
                            <TextBox x:Name="TbName" 
                                     Background="#0C1525"
                                     Foreground="#FFF0F4FF"
                                     BorderBrush="#225DE0FF"
                                     BorderThickness="0,0,0,1"
                                     Padding="10,8"
                                     Height="32"
                                     FontFamily="Segoe UI"
                                     FontSize="13"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="БРЕНД *" 
                                       FontFamily="Segoe UI" FontSize="10" 
                                       Foreground="#88F2F2F2" Margin="0,0,0,4"/>
                            <TextBox x:Name="TbBrand" 
                                     Background="#0C1525"
                                     Foreground="#FFF0F4FF"
                                     BorderBrush="#225DE0FF"
                                     BorderThickness="0,0,0,1"
                                     Padding="10,8"
                                     Height="32"
                                     FontFamily="Segoe UI"
                                     FontSize="13"/>
                        </StackPanel>
                    </Grid>

                    <!-- Row 2: Категория + Состояние -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="КАТЕГОРИЯ *" 
                                       FontFamily="Segoe UI" FontSize="10" 
                                       Foreground="#88F2F2F2" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CbCategory" 
                                       Background="#0C1525"
                                      Foreground="#FF0C1525"
                                      BorderBrush="#FF0C1525"
                                      BorderThickness="0,0,0,1"
                                      Height="32"
                                      Padding="8,5"
                                      FontFamily="Segoe UI"
                                      FontSize="13">
                                <ComboBoxItem Content="Лыжи"/>
                                <ComboBoxItem Content="Сноуборды"/>
                                <ComboBoxItem Content="Маски"/>
                                <ComboBoxItem Content="Шлемы"/>
                                <ComboBoxItem Content="Ботинки"/>
                                <ComboBoxItem Content="Палки"/>
                                <ComboBoxItem Content="Защита"/>
                                <ComboBoxItem Content="Комплекты"/>
                            </ComboBox>
                            
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="СОСТОЯНИЕ *" 
                                       FontFamily="Segoe UI" FontSize="10" 
                                       Foreground="#88F2F2F2" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CbCondition" 
                                      Background="#0C1525"
                                      Foreground="#FF0C1525"
                                      BorderBrush="#FF0C1525"
                                      BorderThickness="0,0,0,1"
                                      Height="32"
                                      Padding="8,5"
                                      FontFamily="Segoe UI"
                                      FontSize="13">
                                <ComboBoxItem Content="Новое"/>
                                <ComboBoxItem Content="Хорошее"/>
                                <ComboBoxItem Content="Удовлетворительное"/>
                                <ComboBoxItem Content="Требует ремонта"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- Row 3: Размер + Цена + Количество -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="РАЗМЕР" 
                                       FontFamily="Segoe UI" FontSize="10" 
                                       Foreground="#88F2F2F2" Margin="0,0,0,4"/>
                            <TextBox x:Name="TbSize" 
                                     Background="#0C1525"
                                     Foreground="#FFF0F4FF"
                                     BorderBrush="#225DE0FF"
                                     BorderThickness="0,0,0,1"
                                     Padding="10,8"
                                     Height="32"
                                     FontFamily="Segoe UI"
                                     FontSize="13"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="ЦЕНА/ДЕНЬ ₽ *" 
                                       FontFamily="Segoe UI" FontSize="10" 
                                       Foreground="#88F2F2F2" Margin="0,0,0,4"/>
                            <TextBox x:Name="TbPrice" 
                                     Background="#0C1525"
                                     Foreground="#FFF0F4FF"
                                     BorderBrush="#225DE0FF"
                                     BorderThickness="0,0,0,1"
                                     Padding="10,8"
                                     Height="32"
                                     FontFamily="Segoe UI"
                                     FontSize="13"
                                     Text="0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="НА СКЛАДЕ *" 
                                       FontFamily="Segoe UI" FontSize="10" 
                                       Foreground="#88F2F2F2" Margin="0,0,0,4"/>
                            <TextBox x:Name="TbStock" 
                                     Background="#0C1525"
                                     Foreground="#FFF0F4FF"
                                     BorderBrush="#225DE0FF"
                                     BorderThickness="0,0,0,1"
                                     Padding="10,8"
                                     Height="32"
                                     FontFamily="Segoe UI"
                                     FontSize="13"
                                     Text="1"/>
                        </StackPanel>
                    </Grid>

                    <!-- Row 4: Ссылка на фото -->
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="ССЫЛКА НА ФОТО" 
                                   FontFamily="Segoe UI" FontSize="10" 
                                   Foreground="#88F2F2F2" Margin="0,0,0,4"/>
                        <TextBox x:Name="TbImage" 
                                 Background="#0C1525"
                                 Foreground="#FFF0F4FF"
                                 BorderBrush="#225DE0FF"
                                 BorderThickness="0,0,0,1"
                                 Padding="10,8"
                                 Height="32"
                                 FontFamily="Segoe UI"
                                 FontSize="13"/>
                    </StackPanel>

                    <!-- Notes -->
                    <StackPanel Margin="0,0,0,28">
                        <TextBlock Text="ЗАМЕТКИ" 
                                   FontFamily="Segoe UI" FontSize="10" 
                                   Foreground="#88F2F2F2" Margin="0,0,0,4"/>
                        <TextBox x:Name="TbNotes" 
                                 Background="#0C1525"
                                 Foreground="#FFF0F4FF"
                                 BorderBrush="#225DE0FF"
                                 BorderThickness="0,0,0,1"
                                 Padding="10,8"
                                 Height="80" 
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True" 
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="Segoe UI"
                                 FontSize="13"/>
                    </StackPanel>

                    <!-- Buttons -->
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnSave" 
                                Content="💾  Сохранить"
                                Background="#FF5DE0FF"
                                Foreground="#FF060810"
                                Padding="20,10"
                                FontFamily="Segoe UI Semibold"
                                FontSize="12"
                                FontWeight="SemiBold"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="BtnSave_Click" 
                                Margin="0,0,10,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                                            CornerRadius="7" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#FF8AECFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Content="Отмена" 
                                Background="Transparent"
                                Foreground="#66A0B8CC"
                                Padding="20,10"
                                FontFamily="Segoe UI"
                                FontSize="12"
                                BorderBrush="#1AFFFFFF"
                                BorderThickness="1"
                                Cursor="Hand"
                                Click="BtnBack_Click" 
                                Margin="0,0,10,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="7" 
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#0FFFFFFF"/>
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#335DE0FF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button x:Name="BtnDelete" 
                                Content="🗑  Удалить"
                                Background="#FFFF5C3A"
                                Foreground="#FFFFFFFF"
                                Padding="20,10"
                                FontFamily="Segoe UI Semibold"
                                FontSize="12"
                                FontWeight="SemiBold"
                                BorderThickness="0"
                                Cursor="Hand"
                                Visibility="Collapsed"
                                Click="BtnDelete_Click"
                                Margin="0,0,10,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                                            CornerRadius="7" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#FFFF7A60"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>