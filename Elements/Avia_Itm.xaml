<UserControl x:Class="pg_26.Elements.Avia_Itm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:pg_26.Elements"
             mc:Ignorable="d" >

    <Border Background="Bisque" Margin="10"  CornerRadius="12" Padding="15,10" BorderBrush="#E0C8A8"  BorderThickness="1">
        <Border.Resources>
            <DropShadowEffect x:Key="DropShadowEffect" BlurRadius="15" Opacity="0.15" ShadowDepth="3" Direction="315"/>
        </Border.Resources>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0" MinWidth="100">
                <TextBlock x:Name="Price" Text="1999 Р" FontSize="24" FontWeight="Bold" Foreground="#D2691E" HorizontalAlignment="Center"/>
                <Button Content="Подробнее" Foreground="White" Background="#D2691E" BorderThickness="0" HorizontalAlignment="Center" Width="120" Height="32" Margin="0,10,0,0" Cursor="Hand" Click="Button_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center"  Margin="0,0,20,0" MinWidth="80">
                <TextBlock Text="Pobeda" FontSize="14" FontWeight="SemiBold" Foreground="#8B4513" Margin="0,0,0,5"/>
                <TextBlock x:Name="TimeStart"  Text="05:50" FontSize="22" FontWeight="Bold" Foreground="#4A2511"/>
                <TextBlock x:Name="From" Text="Пермь"  FontSize="16" Foreground="#6B4F3F" Margin="0,2,0,0"/>
                <TextBlock x:Name="DateStart" Text="29 сент 2021" FontSize="12" Foreground="#8B6B55" Margin="0,2,0,0"/>
            </StackPanel>

            <Grid Grid.Column="2" 
                  VerticalAlignment="Center"
                  Margin="10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.RowSpan="2" 
                        Height="2" 
                        Background="#D2691E"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Stretch"
                        Margin="10,0"
                        Opacity="0.3"/>

                <TextBlock x:Name="TimeWay" 
                           Text="В пути 2ч 15м" 
                           Grid.Row="0"
                           FontSize="12"
                           Foreground="#8B4513"
                           Background="Bisque"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Padding="10,0"
                           Margin="0,-10,0,0"/>

                <Ellipse Grid.Row="1" 
                         Width="8" 
                         Height="8" 
                         Fill="#D2691E"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"
                         Margin="-4,0,0,0"/>

                <Ellipse Grid.Row="1" 
                         Width="8" 
                         Height="8" 
                         Fill="#D2691E"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center"
                         Margin="0,0,-4,0"/>
            </Grid>

            <StackPanel Grid.Column="3" 
                        VerticalAlignment="Center"
                        Margin="20,0,0,0"
                        MinWidth="80">
                <TextBlock Text="Pobeda" 
                           FontSize="14" 
                           FontWeight="SemiBold"
                           Foreground="#8B4513"
                           Margin="0,0,0,5"/>
                <TextBlock x:Name="TimeArrival" 
                           Text="06:05" 
                           FontSize="22" 
                           FontWeight="Bold"
                           Foreground="#4A2511"/>
                <TextBlock x:Name="To" 
                           Text="Москва" 
                           FontSize="16"
                           Foreground="#6B4F3F"
                           Margin="0,2,0,0"/>
                <TextBlock x:Name="DateEnd" 
                           Text="29 сент 2021" 
                           FontSize="12"
                           Foreground="#8B6B55"
                           Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
